{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "experimentalDecorators": true,
    "esModuleInterop": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "*.d.ts"
  ]
}

{
  "name": "Quantum Fluidity Mist",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "#2EE68A",
      "bold": true
    },
    "interface": {
      "foreground": "#FFC53D",
      "italic": true
    },
    "function": {
      "foreground": "#3BD5FF",
      "italic": true
    },
    "method": {
      "foreground": "#3BD5FF",
      "italic": true
    },
    "variable.readonly": {
      "foreground": "#E9EBF5",
      "bold": true
    },
    "variable.defaultLibrary": {
      "foreground": "#3BD5FF",
      "bold": true
    },
    "property": {
      "foreground": "#E9EBF5"
    },
    "parameter": {
      "foreground": "#3BD5FF",
      "italic": true
    },
    "enum": {
      "foreground": "#2EE68A",
      "bold": true
    },
    "enumMember": {
      "foreground": "#FFC53D"
    },
    "type": {
      "foreground": "#2EE68A"
    },
    "typeParameter": {
      "foreground": "#2EE68A",
      "italic": true
    },
    "struct": {
      "foreground": "#2EE68A",
      "bold": true
    },
    "namespace": {
      "foreground": "#E9EBF5"
    },
    "decorator": {
      "foreground": "#3BD5FF",
      "italic": true
    },
    "macro": {
      "foreground": "#BE83FF"
    },
    "event": {
      "foreground": "#FFC53D"
    },
    "property.readonly": {
      "foreground": "#E9EBF5",
      "bold": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },

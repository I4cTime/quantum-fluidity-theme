{
  "name": "Quantum Fluidity Light",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "#067A43",
      "bold": true
    },
    "interface": {
      "foreground": "#A36A00",
      "italic": true
    },
    "function": {
      "foreground": "#007399",
      "italic": true
    },
    "method": {
      "foreground": "#007399",
      "italic": true
    },
    "variable.readonly": {
      "foreground": "#16161D",
      "bold": true
    },
    "variable.defaultLibrary": {
      "foreground": "#007399",
      "bold": true
    },
    "property": {
      "foreground": "#16161D"
    },
    "parameter": {
      "foreground": "#007399",
      "italic": true
    },
    "enum": {
      "foreground": "#067A43",
      "bold": true
    },
    "enumMember": {
      "foreground": "#A36A00"
    },
    "type": {
      "foreground": "#067A43"
    },
    "typeParameter": {
      "foreground": "#067A43",
      "italic": true
    },
    "struct": {
      "foreground": "#067A43",
      "bold": true
    },
    "namespace": {
      "foreground": "#16161D"
    },
    "decorator": {
      "foreground": "#007399",
      "italic": true
    },
    "macro": {
      "foreground": "#7C24D9"
    },
    "event": {
      "foreground": "#A36A00"
    },
    "property.readonly": {
      "foreground": "#16161D",
      "bold": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },

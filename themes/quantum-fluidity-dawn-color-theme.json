{
  "name": "Quantum Fluidity Dawn",
  "type": "light",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "#2E7D32",
      "bold": true
    },
    "interface": {
      "foreground": "#A05A08",
      "italic": true
    },
    "function": {
      "foreground": "#0E7490",
      "italic": true
    },
    "method": {
      "foreground": "#0E7490",
      "italic": true
    },
    "variable.readonly": {
      "foreground": "#2B2119",
      "bold": true
    },
    "variable.defaultLibrary": {
      "foreground": "#0E7490",
      "bold": true
    },
    "property": {
      "foreground": "#2B2119"
    },
    "parameter": {
      "foreground": "#0E7490",
      "italic": true
    },
    "enum": {
      "foreground": "#2E7D32",
      "bold": true
    },
    "enumMember": {
      "foreground": "#A05A08"
    },
    "type": {
      "foreground": "#2E7D32"
    },
    "typeParameter": {
      "foreground": "#2E7D32",
      "italic": true
    },
    "struct": {
      "foreground": "#2E7D32",
      "bold": true
    },
    "namespace": {
      "foreground": "#2B2119"
    },
    "decorator": {
      "foreground": "#0E7490",
      "italic": true
    },
    "macro": {
      "foreground": "#8B2FC9"
    },
    "event": {
      "foreground": "#A05A08"
    },
    "property.readonly": {
      "foreground": "#2B2119",
      "bold": true
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },
